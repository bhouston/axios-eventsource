{
  "name": "axios-eventsource-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "tsc": "tsc -b",
    "dev": "pnpm --parallel --filter axios-eventsource --filter example-express-server --filter example-fastify-server --filter example-website dev",
    "test": "vitest run",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make-release": "node scripts/make-release.mjs packages/axios-eventsource"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
